# HTTP
HTTP_ADDR=:8080

# Database
DATABASE_URL=postgres://sobutylnik:CHANGE_ME@127.0.0.1:5432/sobutylnik?sslmode=disable
DB_MAX_CONNS=8
DB_CONN_TIMEOUT_SECONDS=5

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_32_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_32_BYTES
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Telegram Login Widget
TELEGRAM_BOT_TOKEN=CHANGE_ME

# Cloudflare R2 (S3-compatible object storage for profile photos)
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=sobutylnik-photos
R2_PUBLIC_BASE_URL=https://CHANGE_ME.r2.dev

# Expo Push Notifications
EXPO_PUSH_ACCESS_TOKEN=

# Moderation
REPORT_BAN_THRESHOLD=5
